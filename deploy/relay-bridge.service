[Unit]
Description=Relay v2 — multi-tenant Slack Socket Mode bridge
Documentation=https://github.com/shanerlevy-debug/relay-v2
After=network-online.target postgresql.service relay-api.service
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/relay/bridge
EnvironmentFile=/etc/relay/secrets.env
ExecStart=/opt/relay/bridge/.venv/bin/python -m relay_bridge.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relay /var/log/relay

[Install]
WantedBy=multi-user.target

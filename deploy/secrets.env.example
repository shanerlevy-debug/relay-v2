# /etc/relay/secrets.env — production secrets file.
# Mode 0640, owner root:relay. Loaded by all three systemd units via
# EnvironmentFile=. Each value is mandatory unless marked optional.

# ---- Environment flavor ----
RELAY_ENV=prod
RELAY_LOG_LEVEL=INFO

# ---- Public URLs (used to build OAuth callbacks + cookie scoping) ----
# In prod everything is behind nginx on https://relayed.live.
RELAY_APP_BASE_URL=https://relayed.live
RELAY_API_PUBLIC_URL=https://relayed.live
# Empty = no Domain attr (correct for single-host deploys).
RELAY_OAUTH_COOKIE_DOMAIN=

# ---- Internal (server-side) API URL for Next.js server components ----
# The UI process talks to the API directly over localhost — bypassing nginx.
INTERNAL_API_URL=http://127.0.0.1:8000

# ---- Database ----
# On-box Postgres provisioned by bootstrap.sh.
DATABASE_URL=postgresql+psycopg://relay:_REPLACE_ME_@127.0.0.1:5432/relay

# ---- JWT signing ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=_GENERATE_ME_
JWT_ALGORITHM=HS256
JWT_ISSUER=relay-api
JWT_AUDIENCE=relay-app
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---- AES-256-GCM master key for envelope encryption ----
# 32 raw bytes, base64-encoded. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# bootstrap.sh generates one and writes it to /etc/relay/master.key,
# which secrets.env then references via $(cat ...) on read. For now,
# we just keep it inline here — same file owns both.
RELAY_MASTER_KEY_B64=_GENERATE_ME_

# ---- Slack OAuth (multi-tenant install flow) ----
# From the relayed.live Slack App at api.slack.com/apps:
#   Basic Information -> App Credentials
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_SLACK_BOT_SCOPES="app_mentions:read chat:write chat:write.public channels:history im:history im:write commands"

# ---- Slack App-Level Token (bridge Socket Mode) ----
# From Basic Information -> App-Level Tokens. Workspace-independent.
# Scope: connections:write
RELAY_SLACK_APP_TOKEN=
RELAY_SLACK_SLASH_COMMAND=/relay
RELAY_BRIDGE_LOG_EVENT_TYPES=false

# ---- Google OAuth (login + signup) ----
# OAuth 2.0 Web Application client from console.cloud.google.com.
# Authorized redirect URI: https://relayed.live/api/oauth/google/callback
# Authorized JavaScript origin: https://relayed.live
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ---- Email (deferred — wires when Resend is added) ----
RELAY_EMAIL_PROVIDER=console
RELAY_EMAIL_FROM=no-reply@relayed.live
RELAY_EMAIL_FROM_NAME=Relay

# ---- Plan limits ----
RELAY_USERS_PER_WORKSPACE=25
RELAY_AGENTS_PER_WORKSPACE=25

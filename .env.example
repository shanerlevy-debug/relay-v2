# Copy to .env at the repo root. .env is gitignored.

# ---- Runtime flavor -----------------------------------------------------
RELAY_ENV=dev
RELAY_LOG_LEVEL=INFO

# ---- Database -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://relay:relay_dev@localhost:5432/relay_dev

# ---- Public URLs (drive OAuth callbacks + cookie scoping) ---------------
# In dev: same machine, different ports.
# In prod (relayed.live): both should be https://relayed.live.
RELAY_APP_BASE_URL=http://localhost:3000
RELAY_API_PUBLIC_URL=http://localhost:8000

# OAuth cookie domain. Empty = no Domain attr (correct for single-host).
# Set to ".relayed.live" only if api + app live on different subdomains.
RELAY_OAUTH_COOKIE_DOMAIN=

# ---- Auth (JWTs for the cookie session) ---------------------------------
# Override JWT_SECRET in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-secret-do-not-use-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=relay-api
JWT_AUDIENCE=relay-app
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---- AES-256-GCM master key for envelope encryption ---------------------
# 32 raw bytes, base64-encoded. Generate with:
#   python scripts/generate-master-key.py
# In prod: in a file at /etc/relay/master.key (chmod 0400) read into this var.
RELAY_MASTER_KEY_B64=

# ---- Slack OAuth (multi-tenant install flow — wired in week 1 day 5) ----
# Create one Slack App at api.slack.com/apps, configure /oauth/slack/callback
# at this API's public URL. Per-workspace bot tokens are encrypted into
# Postgres after install.
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_SLACK_BOT_SCOPES=app_mentions:read chat:write chat:write.public channels:history im:history im:write commands

# ---- Transactional email (week 2) ---------------------------------------
# For now console-only — emails print to stdout. Wire to SES once domain
# is DNS-verified.
RELAY_EMAIL_PROVIDER=console
RELAY_EMAIL_FROM=no-reply@relayed.live
RELAY_EMAIL_FROM_NAME=Relay

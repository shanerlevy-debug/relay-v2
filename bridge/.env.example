# Bridge process environment. Mostly shares values with the API's .env;
# add this file's overrides to whichever env is sourced for the bridge's
# systemd unit. In dev a symlink or duplicate of ../.env is fine.

# ---- Same as API ----
DATABASE_URL=postgresql+psycopg://relay:relay_dev@localhost:5432/relay_dev
RELAY_MASTER_KEY_B64=

# ---- Bridge-only ----
# App-Level Token for Slack Socket Mode. Workspace-independent — one per
# Slack App. Generate at Slack App settings -> Basic Information ->
# App-Level Tokens -> scope: connections:write.
RELAY_SLACK_APP_TOKEN=xapp-replace-me

# Slash command. Must match the Slack App manifest.
RELAY_SLACK_SLASH_COMMAND=/ask

# Logging
RELAY_LOG_LEVEL=INFO
RELAY_BRIDGE_LOG_EVENT_TYPES=false
